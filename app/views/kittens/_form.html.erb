<%= form_with model: kitten do |form| %>
  <% if kitten.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(kitten.errors.count, "error") %> prohibited this kitten from being saved:</h2>
      <ul>
        <% kitten.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :age %><br>
    <%= form.text_field :age %>
  </div>

  <div>
    <%= form.label :cuteness %><br>
    <%= form.text_field :cuteness %>
  </div>

  <div>
    <%= form.label :softness %><br>
    <%= form.text_field :softness %>
  </div>

  <br>
  <div>
    <%= form.submit %>
  </div>
<% end %>
